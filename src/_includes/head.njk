<meta charset="UTF-8" />
<meta http-equiv="x-ua-compatible" content="ie=edge" />
<meta name="viewport" content="width=device-width, initial-scale=1, maximum-scale=5" />

{# ── Primary SEO ──────────────────────────────────────────────────────────── #}
{%- if shopPage %}
<title>{{ site.shop.title }} — {{ site.seo.title }}</title>
<meta name="description" content="{{ site.shop.description }}" />
<link rel="canonical" href="{{ site.seo.canonical }}/{{ site.shop.path }}/" />
{%- else %}
<title>{{ site.seo.title }}</title>
<meta name="description" content="{{ site.seo.description }}" />
{% if site.seo.keywords %}
<meta name="keywords" content="{{ site.seo.keywords | join(', ') }}" />
{% endif %}
<link rel="canonical" href="{{ site.seo.canonical }}" />
{%- endif %}

{# ── Open Graph ───────────────────────────────────────────────────────────── #}
{%- if shopPage %}
<meta property="og:type" content="website" />
<meta property="og:title" content="{{ site.shop.title }} — {{ site.seo.title }}" />
<meta property="og:description" content="{{ site.shop.description }}" />
<meta property="og:url" content="{{ site.seo.canonical }}/{{ site.shop.path }}/" />
<meta property="og:image" content="{{ site.shop.og_image if site.shop.og_image else site.seo.og_image }}" />
<meta property="og:image:width" content="600" />
<meta property="og:image:height" content="600" />
<meta property="og:image:type" content="image/jpeg" />
<meta property="og:locale" content="en_US" />
<meta property="og:site_name" content="{{ site.seo.site_name if site.seo.site_name else site.seo.title }}" />
<meta property="og:updated_time" content="{{ buildMeta.unix }}" />
{%- else %}
<meta property="og:type" content="profile" />
<meta property="og:title" content="{{ site.seo.title }}" />
<meta property="og:description" content="{{ site.seo.description }}" />
<meta property="og:url" content="{{ site.seo.canonical }}" />
<meta property="og:image" content="{{ site.seo.og_image }}" />
<meta property="og:image:width" content="600" />
<meta property="og:image:height" content="600" />
<meta property="og:image:type" content="image/jpeg" />
<meta property="og:locale" content="en_US" />
<meta property="og:site_name" content="{{ site.seo.site_name if site.seo.site_name else site.seo.title }}" />
<meta property="og:updated_time" content="{{ buildMeta.unix }}" />
<meta property="profile:username" content="{{ site.profile.username }}" />
{%- if site.seo.manifest and site.seo.manifest.enabled %}
<link rel="manifest" href="/manifest.json" />
{%- endif %}
{%- endif %}

{# ── Twitter Card ─────────────────────────────────────────────────────────── #}
<meta name="twitter:card" content="summary_large_image" />
{%- if shopPage %}
<meta name="twitter:title" content="{{ site.shop.title }} — {{ site.seo.title }}" />
<meta name="twitter:description" content="{{ site.shop.description }}" />
<meta name="twitter:image" content="{{ site.shop.og_image if site.shop.og_image else site.seo.og_image }}" />
{%- else %}
<meta name="twitter:title" content="{{ site.seo.title }}" />
<meta name="twitter:description" content="{{ site.seo.description }}" />
<meta name="twitter:image" content="{{ site.seo.og_image }}" />
{%- endif %}

{# ── Author & Identity Meta Tags ─────────────────────────────────────────── #}
<meta name="author" content="{{ site.profile.name }}" />
<meta name="creator" content="{{ site.profile.name }}" />
<meta name="publisher" content="{{ site.seo.title }}" />

{# ── rel="me" — IndieAuth / Mastodon identity verification ───────────────── #}
{#   Establishes profile ownership for IndieAuth, Mastodon, and IndieWeb.     #}
{%- for social in site.socials %}
<link rel="me" href="{{ social.url }}" />
{%- endfor %}

{# ── Schema.org JSON-LD ───────────────────────────────────────────────────── #}
<script type="application/ld+json">
{
  "@context": "https://schema.org/",
  "@graph": [
    {
      "@type": "ProfilePage",
      "@id": "{{ site.seo.canonical }}#profile-page",
      "name": "{{ site.seo.title }}",
      "url": "{{ site.seo.canonical }}",
      "description": "{{ site.seo.description }}",
      "image": "{{ site.seo.og_image }}",
      "thumbnailUrl": "{{ site.seo.og_image }}",
      "significantLink": "{{ site.seo.canonical }}"
      {%- if site.seo.keywords %},
      "keywords": "{{ site.seo.keywords | join(', ') }}"
      {%- endif %}
      {%- if site.seo.date_created %},
      "dateCreated": "{{ site.seo.date_created }}"
      {%- endif %},
      "dateModified": "{{ buildMeta.iso }}",
      "mainEntity": { "@id": "{{ site.seo.canonical }}#person" }
      {%- if recentContent and recentContent.length %},
      "hasPart": [
        {%- for article in recentContent %}
        {%- if not loop.first %},{%- endif %}
        {
          "@type": "Article",
          "headline": "{{ article.headline | jsonEscape }}",
          "url": "{{ article.url }}",
          "image": "{{ article.image if article.image else site.seo.og_image }}"
          {%- if article.datePublished %},
          "datePublished": "{{ article.datePublished }}"
          {%- endif %},
          "author": { "@id": "{{ site.seo.canonical }}#person" }
        }
        {%- endfor %}
      ]
      {%- endif %}
    },
    {
      "@type": "Person",
      "@id": "{{ site.seo.canonical }}#person",
      "name": "{{ site.profile.name }}",
      "alternateName": "{{ site.profile.username }}",
      "identifier": "{{ site.profile.username }}",
      "description": "{{ site.profile.tagline if site.profile.tagline else site.seo.description }}",
      "image": "{{ site.seo.og_image }}",
      "url": "{{ site.seo.canonical }}"
      {%- if site.socials %},
      "sameAs": [
        {%- for social in site.socials %}
        "{{ social.url.split('?') | first }}"{% if not loop.last %},{% endif %}
        {%- endfor %}
      ]
      {%- endif %}
      {%- if site.seo.person and site.seo.person.roles %},
      "jobTitle": [
        {%- for role in site.seo.person.roles %}
        "{{ role.job_title | jsonEscape }}"{% if not loop.last %},{% endif %}
        {%- endfor %}
      ],
      "worksFor": [
        {%- for role in site.seo.person.roles %}
        {"@type": "Organization", "name": "{{ role.works_for | jsonEscape }}"{% if role.works_for_url %}, "url": "{{ role.works_for_url }}"{% endif %}}{% if not loop.last %},{% endif %}
        {%- endfor %}
      ]
      {%- endif %}
      {%- if socialStats and socialStats.stats and socialStats.stats.length %},
      "interactionStatistic": [
        {%- for stat in socialStats.stats %}
        {%- if not loop.first %},{%- endif %}
        {"@type": "InteractionCounter", "interactionType": "https://schema.org/FollowAction", "interactionService": {"@type": "Website", "name": "{{ stat.serviceName | jsonEscape }}", "url": "{{ stat.serviceUrl }}"}, "userInteractionCount": {{ stat.followersCount }}}
        {%- endfor %}
      ]
      {%- elif site.seo.person and site.seo.person.stats %},
      "interactionStatistic": [
        {%- set stats = site.seo.person.stats %}
        {%- if stats.followers %}
        {"@type": "InteractionCounter", "interactionType": "https://schema.org/FollowAction", "userInteractionCount": {{ stats.followers }}}{% if stats.posts_written %},{% endif %}
        {%- endif %}
        {%- if stats.posts_written %}
        {"@type": "InteractionCounter", "interactionType": "https://schema.org/WriteAction", "userInteractionCount": {{ stats.posts_written }}}
        {%- endif %}
      ]
      {%- endif %}
      {%- if site.profile.topics %},
      "knowsAbout": [
        {%- for topic in site.profile.topics %}
        "{{ topic | jsonEscape | safe }}"{% if not loop.last %},{% endif %}
        {%- endfor %}
      ]
      {%- endif %}
      {%- if site.profile.location %},
      "homeLocation": {"@type": "Place", "name": "{{ site.profile.location | jsonEscape | safe }}"}
      {%- endif %}
      {%- if site.profile.language %},
      "knowsLanguage": "{{ site.profile.language | jsonEscape | safe }}"
      {%- endif %}
      {%- if site.profile.creator_type %},
      "hasOccupation": {"@type": "Occupation", "name": "{{ site.profile.creator_type | jsonEscape | safe }}"}
      {%- endif %}
      {%- if site.seo.person and site.seo.person.awards %},
      "award": [
        {%- for award in site.seo.person.awards %}
        "{{ award | jsonEscape | safe }}"{% if not loop.last %},{% endif %}
        {%- endfor %}
      ]
      {%- endif %}
      {%- if site.seo.person and site.seo.person.credentials %},
      "hasCredential": [
        {%- for cred in site.seo.person.credentials %}
        {%- if not loop.first %},{%- endif %}
        {"@type": "EducationalOccupationalCredential", "name": "{{ cred.name | jsonEscape | safe }}"{% if cred.url %}, "url": "{{ cred.url }}"{% endif %}{% if cred.category %}, "credentialCategory": "{{ cred.category | jsonEscape | safe }}"{% endif %}}
        {%- endfor %}
      ]
      {%- endif %}
      {%- if site.profile.contact_url %},
      "contactPoint": {"@type": "ContactPoint", "contactType": "Work inquiries", "url": "{{ site.profile.contact_url }}"}
      {%- endif %}
    }
    {%- if site.sections and not shopPage %},
    {
      "@type": "ItemList",
      "@id": "{{ site.seo.canonical }}#links",
      "name": "{{ site.seo.title | jsonEscape }} — Links",
      "url": "{{ site.seo.canonical }}",
      "itemListElement": [
        {%- set allLinks = site.sections | flatLinks %}
        {%- for link in allLinks %}
        {%- if not loop.first %},{%- endif %}
        {"@type": "ListItem", "position": {{ link.position }}, "name": "{{ link.title | jsonEscape }}", "url": "{{ link.url }}"}
        {%- endfor %}
      ]
    }
    {%- endif %}
  ]
}
</script>

{# ── Shop page JSON-LD (ItemList with Course/Service/Product per item type) ── #}
{%- if shopPage and site.shop.enabled and site.shop.collections %}
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "ItemList",
  "name": "{{ site.shop.title | jsonEscape }} — {{ site.seo.title | jsonEscape }}",
  "url": "{{ site.seo.canonical }}/{{ site.shop.path }}/",
  "itemListElement": [
    {%- set _shopItems = site.shop.collections | shopItems %}
    {%- for item in _shopItems %}
    {%- if not loop.first %},{%- endif %}
    {
      "@type": "ListItem",
      "position": {{ item.position }},
      "item": {
        {%- if item.type == "course" %}
        "@type": "Course",
        "name": "{{ item.title | jsonEscape }}"
        {%- if item.description %},
        "description": "{{ item.description | jsonEscape }}"
        {%- endif %}
        {%- if item.image %},
        "image": "{{ item.image }}"
        {%- endif %},
        "url": "{{ item.url }}",
        "provider": {"@id": "{{ site.seo.canonical }}#person"}
        {%- if item.price is number %},
        "hasCourseInstance": {
          "@type": "CourseInstance",
          "courseMode": "online",
          "offers": {
            "@type": "Offer",
            "price": "{{ item.price }}",
            "priceCurrency": "{{ item.currency if item.currency else site.shop.currency }}",
            "availability": "https://schema.org/InStock",
            "url": "{{ item.url }}"
          }
        }
        {%- endif %}
        {%- elif item.type == "service" or item.type == "consultation" %}
        "@type": "Service",
        "name": "{{ item.title | jsonEscape }}"
        {%- if item.description %},
        "description": "{{ item.description | jsonEscape }}"
        {%- endif %}
        {%- if item.image %},
        "image": "{{ item.image }}"
        {%- endif %},
        "url": "{{ item.url }}"
        {%- if item.price is number %},
        "offers": {
          "@type": "Offer",
          "price": "{{ item.price }}",
          "priceCurrency": "{{ item.currency if item.currency else site.shop.currency }}",
          "availability": "https://schema.org/InStock",
          "url": "{{ item.url }}"
        }
        {%- endif %}
        {%- elif item.type == "book" %}
        "@type": "Book",
        "name": "{{ item.title | jsonEscape }}"
        {%- if item.description %},
        "description": "{{ item.description | jsonEscape }}"
        {%- endif %}
        {%- if item.image %},
        "image": "{{ item.image }}"
        {%- endif %},
        "url": "{{ item.url }}",
        "author": {"@id": "{{ site.seo.canonical }}#person"}
        {%- if item.price is number %},
        "offers": {
          "@type": "Offer",
          "price": "{{ item.price }}",
          "priceCurrency": "{{ item.currency if item.currency else site.shop.currency }}",
          "availability": "https://schema.org/InStock",
          "url": "{{ item.url }}"
        }
        {%- endif %}
        {%- else %}
        "@type": "Product",
        "name": "{{ item.title | jsonEscape }}"
        {%- if item.description %},
        "description": "{{ item.description | jsonEscape }}"
        {%- endif %}
        {%- if item.image %},
        "image": "{{ item.image }}"
        {%- endif %},
        "url": "{{ item.url }}",
        "offers": {
          "@type": "Offer",
          "availability": "https://schema.org/InStock",
          "url": "{{ item.url }}"
          {%- if item.price is number %},
          "price": "{{ item.price }}",
          "priceCurrency": "{{ item.currency if item.currency else site.shop.currency }}"
          {%- endif %}
        }
        {%- endif %}
      }
    }
    {%- endfor %}
  ]
}
</script>
{%- endif %}

{# ── FAQPage structured data ──────────────────────────────────────────────── #}
{#   Source: developers.google.com/search/docs/appearance/structured-data/faqpage #}
{%- if not shopPage and site.integrations and site.integrations.faq
    and site.integrations.faq.enabled and site.integrations.faq.items
    and site.integrations.faq.items.length %}
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "@id": "{{ site.seo.canonical }}#faq",
  "mainEntity": [
    {%- for item in site.integrations.faq.items %}
    {%- if not loop.first %},{%- endif %}
    {
      "@type": "Question",
      "name": "{{ item.question | jsonEscape }}",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "{{ item.answer | jsonEscape }}"
      }
    }
    {%- endfor %}
  ]
}
</script>
{%- endif %}

{# ── BreadcrumbList structured data ──────────────────────────────────────── #}
{#   Source: developers.google.com/search/docs/appearance/structured-data/breadcrumb #}
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "@id": "{{ site.seo.canonical }}#breadcrumb",
  "itemListElement": [
    {"@type": "ListItem", "position": 1, "name": "Home", "item": "{{ site.seo.canonical }}"}
    {%- if shopPage and site.shop %},
    {"@type": "ListItem", "position": 2, "name": "{{ site.shop.title | jsonEscape }}", "item": "{{ site.seo.canonical }}/{{ site.shop.path }}/"}
    {%- endif %}
  ]
}
</script>

{# ── Speakable structured data (Google BETA) ──────────────────────────────── #}
{#   Marks page sections as voice-assistant readable.                          #}
{#   Source: developers.google.com/search/docs/appearance/structured-data/speakable #}
{%- if not shopPage %}
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "WebPage",
  "@id": "{{ site.seo.canonical }}#webpage",
  "url": "{{ site.seo.canonical }}",
  "speakable": {
    "@type": "SpeakableSpecification",
    "cssSelector": [".profile-bio"{% if site.integrations and site.integrations.faq and site.integrations.faq.enabled %}, ".integration-faq-answer"{% endif %}]
  }
}
</script>
{%- endif %}

{# ── LCP preload — banner image (fetched ASAP, before CSS blocks rendering) ── #}
{# When banner_webp/srcset configured, preloads WebP with imagesrcset for responsive hints ── #}
{%- if site.profile.banner %}
{%- if site.profile.banner_webp and site.profile.banner_srcset_webp %}
<link rel="preload" as="image" href="{{ site.profile.banner_webp }}" imagesrcset="{{ site.profile.banner_srcset_webp }}" imagesizes="100vw" fetchpriority="high" type="image/webp" />
{%- else %}
<link rel="preload" as="image" href="{{ site.profile.banner }}" fetchpriority="high" />
{%- endif %}
{%- endif %}

{# ── Hero sizing — set CSS vars before first paint to eliminate CLS ─────────── #}
{# Runs synchronously in <head>: browser has correct values on first render.     #}
{# Calculates: hero width = clientWidth (no scrollbar), margin-left = negative  #}
{# offset to break out of the centered 680px content column to full viewport.   #}
{%- if site.profile.banner_hero %}
<script>(function(){var vw=window.innerWidth;var cw=Math.min(680,vw-32);document.documentElement.style.setProperty('--hero-w',vw+'px');document.documentElement.style.setProperty('--hero-ml',(-(vw-cw)/2)+'px');})()</script>
{%- endif %}

{# ── Theme CSS — inlined to eliminate network round-trip and avoid FOUC ─────── #}
{# Fonts are NOT @imported in theme.css (would create a blocking chain).        #}
{# They are async-loaded below via site.font_url with preconnect hints.         #}
<link rel="stylesheet" href="/assets/base.css" />
{%- if site.shop and site.shop.enabled %}
{%- if page.url == '/shop/' %}
{# On /shop/ shop.css is critical for above-fold product grid — load sync #}
<link rel="stylesheet" href="/assets/shop.css" />
{%- else %}
{# On other pages shop nav tabs are below-fold — async is safe #}
<link rel="preload" href="/assets/shop.css" as="style" onload="this.onload=null;this.rel='stylesheet'" />
<noscript><link rel="stylesheet" href="/assets/shop.css" /></noscript>
{%- endif %}
{%- endif %}
{%- if site.theme %}
{%- set _themePath = "src/themes/" + site.theme + "/theme.css" %}
<style>{% inlineFile _themePath %}</style>
{%- endif %}
{# ── Google Fonts (or custom font_url) — async with preconnect hints ─────────── #}
{# Loaded separately from theme.css to avoid render-blocking @import chain.      #}
{%- if site.font_url %}
<link rel="preconnect" href="https://fonts.googleapis.com" />
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
<link rel="preload" href="{{ site.font_url }}" as="style" onload="this.onload=null;this.rel='stylesheet'" />
<noscript><link rel="stylesheet" href="{{ site.font_url }}" /></noscript>
{%- endif %}

{# ── Integrations assets (loaded when any interactive widget is enabled) ──── #}
{%- set _igs = site.integrations if site.integrations else {} %}
{%- set _hasWidget = false %}
{%- for _k in ['newsletter','social_follow','support_buttons','booking','poll','contact_form','lead_magnet','social_proof','discord','badges','testimonials','code_embeds','qr_code'] %}
  {%- if _igs[_k] and _igs[_k].enabled %}{%- set _hasWidget = true %}{%- endif %}
{%- endfor %}
{%- if _hasWidget %}
{# Async-load integrations.css — above-fold banner/flip CSS is already in base.css  #}
{# rel=preload fetches immediately without blocking render; onload applies styles    #}
<link rel="preload" href="/assets/integrations.css" as="style" onload="this.onload=null;this.rel='stylesheet'" />
<noscript><link rel="stylesheet" href="/assets/integrations.css" /></noscript>
<script src="/assets/integrations.js" defer></script>
{%- endif %}

{# ── Google Analytics (injected via GOOGLE_ANALYTICS_ID CI secret) ─────────── #}
{% if env.GOOGLE_ANALYTICS_ID %}
<script async src="https://www.googletagmanager.com/gtag/js?id={{ env.GOOGLE_ANALYTICS_ID }}"></script>
<script>
  window.dataLayer = window.dataLayer || [];
  function gtag(){dataLayer.push(arguments);}
  gtag('js', new Date());
  gtag('config', '{{ env.GOOGLE_ANALYTICS_ID }}');
</script>
<script>
(function () {
  var n = "{{ site.ga_event_name or 'creator_link_click' }}";
  var _rSocial   = /\b(youtube|youtu\.be|twitter|x\.com|instagram|tiktok|linkedin|github|discord|twitch|kick|bluesky|mastodon|threads|facebook|pinterest|reddit|bsky\.app)\b/i;
  var _rNewsltr  = /\b(substack|mailchimp|beehiiv|convertkit|brevo|revue|buttondown|ghost)\b/i;
  var _rBooking  = /\b(tidycal|calendly|cal\.com)\b/i;
  var _rVideo    = /\b(youtube|youtu\.be|vimeo|twitch\.tv|kick\.com)\b/i;
  function _linkCat(href) {
    try {
      var h = new URL(href, location.href).hostname;
      if (_rVideo.test(h))   return "video";
      if (_rSocial.test(h))  return "social";
      if (_rNewsltr.test(h)) return "newsletter";
      if (_rBooking.test(h)) return "booking";
    } catch (e) {}
    return "external";
  }
  document.addEventListener("click", function (e) {
    var a = e.target.closest("a");
    if (!a || typeof gtag === "undefined") return;
    var label   = a.dataset.gaLabel;
    var type    = a.dataset.gaType;
    var section = a.dataset.gaSection;
    if (!label) {
      var container = a.closest("[data-ga-section]");
      if (!container) return;
      section = section || container.dataset.gaSection;
      type    = type    || container.dataset.gaType || "auto_link";
      label   = (a.textContent || "").trim().toLowerCase().replace(/\s+/g, "_")
                || new URL(a.href, location.href).hostname.replace(/^www\./, "");
    }
    gtag("event", n, { destination: label, link_type: type, section: section, link_category: _linkCat(a.href) });
  });
}());
</script>
<script>
(function () {
  if (typeof gtag === "undefined") return;

  // Scroll depth milestones: 25 / 50 / 75 / 100 %
  var _sdFired = {};
  window.addEventListener("scroll", function () {
    var pct = (window.scrollY + window.innerHeight) / document.documentElement.scrollHeight * 100;
    [25, 50, 75, 100].forEach(function (m) {
      if (!_sdFired[m] && pct >= m) { _sdFired[m] = true; gtag("event", "scroll_depth", { percent_scrolled: m }); }
    });
  }, { passive: true });

  // Time-on-page milestones: 30 / 60 / 120 / 300 s (paused when tab hidden)
  var _tabHidden = false;
  document.addEventListener("visibilitychange", function () { _tabHidden = document.hidden; });
  [30, 60, 120, 300].forEach(function (s) {
    setTimeout(function () { if (!_tabHidden) gtag("event", "time_on_page", { time_on_page_sec: s }); }, s * 1000);
  });

  // First interaction: time from page load to first click/key/touch
  var _fiT0 = Date.now(), _fiFired = false;
  function _fi(e) {
    if (_fiFired) return; _fiFired = true;
    gtag("event", "first_interaction", {
      element_type: e.target.tagName.toLowerCase(),
      time_to_first_interaction_ms: Date.now() - _fiT0
    });
  }
  ["click", "keydown", "touchstart"].forEach(function (ev) {
    document.addEventListener(ev, _fi, { once: true, passive: true });
  });
}());
</script>
{% endif %}

{# ── UTM sessionStorage persistence (runs regardless of GA config) ─────────── #}
<script>
(function () {
  var _utmKeys = ["utm_source","utm_medium","utm_campaign","utm_content","utm_term"];
  var _params  = new URLSearchParams(location.search);
  _utmKeys.forEach(function (k) { var v = _params.get(k); if (v) sessionStorage.setItem(k, v); });
  // Re-attach stored UTMs to same-origin navigation links
  document.addEventListener("click", function (e) {
    var a = e.target.closest("a");
    if (!a || !a.href) return;
    try {
      var u = new URL(a.href);
      if (u.origin !== location.origin) return;
      _utmKeys.forEach(function (k) {
        var v = sessionStorage.getItem(k);
        if (v && !u.searchParams.has(k)) u.searchParams.set(k, v);
      });
      a.href = u.toString();
    } catch (x) {}
  });
}());
</script>

