<meta charset="UTF-8" />
<meta http-equiv="x-ua-compatible" content="ie=edge" />
<meta name="viewport" content="width=device-width, initial-scale=1, maximum-scale=5" />
{%- set _ogImg = (site.seo.canonical + "/assets/og-image-auto.png") if site.seo.og_image_auto else site.seo.og_image %}

{# ── Primary SEO ──────────────────────────────────────────────────────────── #}
{%- if shopPage %}
<title>{{ site.shop.title }} — {{ site.seo.title }}</title>
<meta name="description" content="{{ site.shop.description }}" />
<link rel="canonical" href="{{ site.seo.canonical }}/{{ site.shop.path }}/" />
{%- else %}
<title>{{ site.seo.title }}</title>
<meta name="description" content="{{ site.seo.description }}" />
{% if site.seo.keywords %}
<meta name="keywords" content="{{ site.seo.keywords | join(', ') }}" />
{% endif %}
<link rel="canonical" href="{{ site.seo.canonical }}" />
{%- endif %}

{# ── Open Graph ───────────────────────────────────────────────────────────── #}
{%- if shopPage %}
<meta property="og:type" content="website" />
<meta property="og:title" content="{{ site.shop.title }} — {{ site.seo.title }}" />
<meta property="og:description" content="{{ site.shop.description }}" />
<meta property="og:url" content="{{ site.seo.canonical }}/{{ site.shop.path }}/" />
<meta property="og:image" content="{{ site.shop.og_image if site.shop.og_image else _ogImg }}" />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />
<meta property="og:image:type" content="image/png" />
<meta property="og:locale" content="en_US" />
<meta property="og:site_name" content="{{ site.seo.site_name if site.seo.site_name else site.seo.title }}" />
{%- if site.shop.date_modified %}
<meta property="og:updated_time" content="{{ site.shop.date_modified }}" />
{%- endif %}
{%- else %}
<meta property="og:type" content="profile" />
<meta property="og:title" content="{{ site.seo.title }}" />
<meta property="og:description" content="{{ site.seo.description }}" />
<meta property="og:url" content="{{ site.seo.canonical }}" />
<meta property="og:image" content="{{ _ogImg }}" />
<meta property="og:image:width" content="{{ "1200" if site.seo.og_image_auto else "600" }}" />
<meta property="og:image:height" content="{{ "630" if site.seo.og_image_auto else "600" }}" />
<meta property="og:image:type" content="{{ "image/png" if site.seo.og_image_auto else "image/jpeg" }}" />
<meta property="og:locale" content="en_US" />
<meta property="og:site_name" content="{{ site.seo.site_name if site.seo.site_name else site.seo.title }}" />
{%- if site.seo.date_modified %}
<meta property="og:updated_time" content="{{ site.seo.date_modified }}" />
{%- endif %}
<meta property="profile:username" content="{{ site.profile.username }}" />
{%- if site.seo.manifest and site.seo.manifest.enabled %}
<link rel="manifest" href="/manifest.json" />
{%- endif %}
{%- endif %}

{# ── Twitter Card ─────────────────────────────────────────────────────────── #}
<meta name="twitter:card" content="summary_large_image" />
{%- if shopPage %}
<meta name="twitter:title" content="{{ site.shop.title }} — {{ site.seo.title }}" />
<meta name="twitter:description" content="{{ site.shop.description }}" />
<meta name="twitter:image" content="{{ site.shop.og_image if site.shop.og_image else _ogImg }}" />
{%- else %}
<meta name="twitter:title" content="{{ site.seo.title }}" />
<meta name="twitter:description" content="{{ site.seo.description }}" />
<meta name="twitter:image" content="{{ _ogImg }}" />
{%- endif %}

{# ── Author & Identity Meta Tags ─────────────────────────────────────────── #}
<meta name="author" content="{{ site.profile.name }}" />
<meta name="creator" content="{{ site.profile.name }}" />
<meta name="publisher" content="{{ site.seo.title }}" />

{# ── rel="me" — IndieAuth / Mastodon identity verification ───────────────── #}
{#   Establishes profile ownership for IndieAuth, Mastodon, and IndieWeb.     #}
{%- for social in site.socials %}
<link rel="me" href="{{ social.url }}" />
{%- endfor %}

{# ── Schema.org JSON-LD ───────────────────────────────────────────────────── #}
{%- set _structuredData = site | structuredData(shopPage, recentContent, socialStats, youtubeChannels, _ogImg) %}
{%- for document in _structuredData %}
<script type="application/ld+json">{{ document | serializeJsonLd | safe }}</script>
{%- endfor %}

{# ── LCP preload — banner image (fetched ASAP, before CSS blocks rendering) ── #}
{# When banner_webp/srcset configured, preloads WebP with imagesrcset for responsive hints ── #}
{%- if site.profile.banner %}
{%- if site.profile.banner_webp and site.profile.banner_srcset_webp %}
<link rel="preload" as="image" href="{{ site.profile.banner_webp }}" imagesrcset="{{ site.profile.banner_srcset_webp }}" imagesizes="100vw" fetchpriority="high" type="image/webp" />
{%- else %}
<link rel="preload" as="image" href="{{ site.profile.banner }}" fetchpriority="high" />
{%- endif %}
{%- endif %}

{# ── Hero sizing — set CSS vars before first paint to eliminate CLS ─────────── #}
{# Runs synchronously in <head>: browser has correct values on first render.     #}
{# Calculates: hero width = clientWidth (no scrollbar), margin-left = negative  #}
{# offset to break out of the centered 680px content column to full viewport.   #}
{%- if site.profile.banner_hero %}
<script>(function(){var vw=window.innerWidth;var cw=Math.min(680,vw-32);document.documentElement.style.setProperty('--hero-w',vw+'px');document.documentElement.style.setProperty('--hero-ml',(-(vw-cw)/2)+'px');})()</script>
{%- endif %}

{# ── Base CSS — inlined to eliminate render-blocking network chain ───────────── #}
{# Theme CSS below is also inlined. Both arrive with the HTML in a single round-  #}
{# trip; no parser-blocking link elements remain in the critical path.            #}
<style>{% inlineFile "src/assets/base.css" %}</style>
{%- if site.shop and site.shop.enabled %}
{%- if page.url == '/shop/' %}
{# On /shop/ shop.css is critical for above-fold product grid — load sync #}
<link rel="stylesheet" href="/assets/shop.css" />
{%- else %}
{# On other pages shop nav tabs are below-fold — async is safe #}
<link rel="preload" href="/assets/shop.css" as="style" onload="this.onload=null;this.rel='stylesheet'" />
<noscript><link rel="stylesheet" href="/assets/shop.css" /></noscript>
{%- endif %}
{%- endif %}
{%- if site.theme %}
{%- set _themePath = "src/themes/" + site.theme + "/theme.css" %}
<style>{% inlineFile _themePath %}</style>
{%- endif %}
{# ── Google Fonts (or custom font_url) — async with preconnect hints ─────────── #}
{# Loaded separately from theme.css to avoid render-blocking @import chain.      #}
{%- if site.font_url %}
<link rel="preconnect" href="https://fonts.googleapis.com" />
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
<link rel="preload" href="{{ site.font_url }}" as="style" onload="this.onload=null;this.rel='stylesheet'" />
<noscript><link rel="stylesheet" href="{{ site.font_url }}" /></noscript>
{%- endif %}

{# ── Integrations assets (loaded when any interactive widget is enabled) ──── #}
{%- set _igs = site.integrations if site.integrations else {} %}
{%- set _hasWidget = false %}
{%- for _k in ['newsletter','social_follow','support_buttons','booking','poll','contact_form','lead_magnet','social_proof','discord','badges','testimonials','code_embeds','qr_code'] %}
  {%- if _igs[_k] and _igs[_k].enabled %}{%- set _hasWidget = true %}{%- endif %}
{%- endfor %}
{%- if _hasWidget %}
{# Inline integrations.css — async loading caused FOUC and CLS for widgets that    #}
{# render in the initial HTML (e.g. newsletter). Inlining costs ~4KB but eliminates #}
{# the layout shift from unstyled-then-styled widget containers.                    #}
<style>{% inlineFile "src/assets/integrations.css" %}</style>
<script src="/assets/integrations.js" defer></script>
{%- endif %}

{# ── Google Analytics (injected via GOOGLE_ANALYTICS_ID CI secret) ─────────── #}
{% if env.GOOGLE_ANALYTICS_ID %}
<script async src="https://www.googletagmanager.com/gtag/js?id={{ env.GOOGLE_ANALYTICS_ID }}"></script>
<script>
  window.dataLayer = window.dataLayer || [];
  function gtag(){dataLayer.push(arguments);}
  gtag('js', new Date());
  gtag('config', '{{ env.GOOGLE_ANALYTICS_ID }}');
</script>
<script>
(function () {
  var n = "{{ site.ga_event_name or 'creator_link_click' }}";
  var _rSocial   = /\b(youtube|youtu\.be|twitter|x\.com|instagram|tiktok|linkedin|github|discord|twitch|kick|bluesky|mastodon|threads|facebook|pinterest|reddit|bsky\.app)\b/i;
  var _rNewsltr  = /\b(substack|mailchimp|beehiiv|convertkit|brevo|revue|buttondown|ghost)\b/i;
  var _rBooking  = /\b(tidycal|calendly|cal\.com)\b/i;
  var _rVideo    = /\b(youtube|youtu\.be|vimeo|twitch\.tv|kick\.com)\b/i;
  function _linkCat(href) {
    try {
      var h = new URL(href, location.href).hostname;
      if (_rVideo.test(h))   return "video";
      if (_rSocial.test(h))  return "social";
      if (_rNewsltr.test(h)) return "newsletter";
      if (_rBooking.test(h)) return "booking";
    } catch (e) {}
    return "external";
  }
  document.addEventListener("click", function (e) {
    var a = e.target.closest("a");
    if (!a || typeof gtag === "undefined") return;
    var label   = a.dataset.gaLabel;
    var type    = a.dataset.gaType;
    var section = a.dataset.gaSection;
    if (!label) {
      var container = a.closest("[data-ga-section]");
      if (!container) return;
      section = section || container.dataset.gaSection;
      type    = type    || container.dataset.gaType || "auto_link";
      label   = (a.textContent || "").trim().toLowerCase().replace(/\s+/g, "_")
                || new URL(a.href, location.href).hostname.replace(/^www\./, "");
    }
    gtag("event", n, { destination: label, link_type: type, section: section, link_category: _linkCat(a.href) });
  });
}());
</script>
<script>
(function () {
  if (typeof gtag === "undefined") return;

  // Scroll depth milestones: 25 / 50 / 75 / 100 %
  var _sdFired = {};
  window.addEventListener("scroll", function () {
    var pct = (window.scrollY + window.innerHeight) / document.documentElement.scrollHeight * 100;
    [25, 50, 75, 100].forEach(function (m) {
      if (!_sdFired[m] && pct >= m) { _sdFired[m] = true; gtag("event", "scroll_depth", { percent_scrolled: m }); }
    });
  }, { passive: true });

  // Time-on-page milestones: 30 / 60 / 120 / 300 s (paused when tab hidden)
  var _tabHidden = false;
  document.addEventListener("visibilitychange", function () { _tabHidden = document.hidden; });
  [30, 60, 120, 300].forEach(function (s) {
    setTimeout(function () { if (!_tabHidden) gtag("event", "time_on_page", { time_on_page_sec: s }); }, s * 1000);
  });

  // First interaction: time from page load to first click/key/touch
  var _fiT0 = Date.now(), _fiFired = false;
  function _fi(e) {
    if (_fiFired) return; _fiFired = true;
    gtag("event", "first_interaction", {
      element_type: e.target.tagName.toLowerCase(),
      time_to_first_interaction_ms: Date.now() - _fiT0
    });
  }
  ["click", "keydown", "touchstart"].forEach(function (ev) {
    document.addEventListener(ev, _fi, { once: true, passive: true });
  });
}());
</script>
{% endif %}

{# ── UTM sessionStorage persistence (runs regardless of GA config) ─────────── #}
<script>
(function () {
  var _utmKeys = ["utm_source","utm_medium","utm_campaign","utm_content","utm_term"];
  var _params  = new URLSearchParams(location.search);
  _utmKeys.forEach(function (k) { var v = _params.get(k); if (v) sessionStorage.setItem(k, v); });
  // Re-attach stored UTMs to same-origin navigation links
  document.addEventListener("click", function (e) {
    var a = e.target.closest("a");
    if (!a || !a.href) return;
    try {
      var u = new URL(a.href);
      if (u.origin !== location.origin) return;
      _utmKeys.forEach(function (k) {
        var v = sessionStorage.getItem(k);
        if (v && !u.searchParams.has(k)) u.searchParams.set(k, v);
      });
      a.href = u.toString();
    } catch (x) {}
  });
}());
</script>

{# ── Favicons ─────────────────────────────────────────────────────────────── #}
{% if site.favicon and site.favicon.mode and site.favicon.mode != "none" %}
<link rel="icon" type="image/png" sizes="512x512" href="/assets/favicon.png" />
<link rel="icon" type="image/png" sizes="32x32" href="/assets/favicon-32x32.png" />
<link rel="icon" type="image/png" sizes="16x16" href="/assets/favicon-16x16.png" />
<link rel="apple-touch-icon" sizes="180x180" href="/assets/apple-touch-icon.png" />
{% endif %}
<meta name="theme-color" content="#1E2330" />
