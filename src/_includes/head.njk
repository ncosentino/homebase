<meta charset="UTF-8" />
<meta http-equiv="x-ua-compatible" content="ie=edge" />
<meta name="viewport" content="width=device-width, initial-scale=1, maximum-scale=5" />

{# ── Primary SEO ──────────────────────────────────────────────────────────── #}
{%- if shopPage %}
<title>{{ site.shop.title }} — {{ site.seo.title }}</title>
<meta name="description" content="{{ site.shop.description }}" />
<link rel="canonical" href="{{ site.seo.canonical }}/{{ site.shop.path }}/" />
{%- else %}
<title>{{ site.seo.title }}</title>
<meta name="description" content="{{ site.seo.description }}" />
{% if site.seo.keywords %}
<meta name="keywords" content="{{ site.seo.keywords | join(', ') }}" />
{% endif %}
<link rel="canonical" href="{{ site.seo.canonical }}" />
{%- endif %}

{# ── Open Graph ───────────────────────────────────────────────────────────── #}
{%- if shopPage %}
<meta property="og:type" content="website" />
<meta property="og:title" content="{{ site.shop.title }} — {{ site.seo.title }}" />
<meta property="og:description" content="{{ site.shop.description }}" />
<meta property="og:url" content="{{ site.seo.canonical }}/{{ site.shop.path }}/" />
<meta property="og:image" content="{{ site.shop.og_image if site.shop.og_image else site.seo.og_image }}" />
<meta property="og:image:width" content="600" />
<meta property="og:image:height" content="600" />
<meta property="og:image:type" content="image/jpeg" />
<meta property="og:locale" content="en_US" />
<meta property="og:site_name" content="{{ site.seo.site_name if site.seo.site_name else site.seo.title }}" />
<meta property="og:updated_time" content="{{ buildMeta.unix }}" />
{%- else %}
<meta property="og:type" content="profile" />
<meta property="og:title" content="{{ site.seo.title }}" />
<meta property="og:description" content="{{ site.seo.description }}" />
<meta property="og:url" content="{{ site.seo.canonical }}" />
<meta property="og:image" content="{{ site.seo.og_image }}" />
<meta property="og:image:width" content="600" />
<meta property="og:image:height" content="600" />
<meta property="og:image:type" content="image/jpeg" />
<meta property="og:locale" content="en_US" />
<meta property="og:site_name" content="{{ site.seo.site_name if site.seo.site_name else site.seo.title }}" />
<meta property="og:updated_time" content="{{ buildMeta.unix }}" />
<meta property="profile:username" content="{{ site.profile.username }}" />
{%- if site.seo.manifest and site.seo.manifest.enabled %}
<link rel="manifest" href="/manifest.json" />
{%- endif %}
{%- endif %}

{# ── Twitter Card ─────────────────────────────────────────────────────────── #}
<meta name="twitter:card" content="summary_large_image" />
{%- if shopPage %}
<meta name="twitter:title" content="{{ site.shop.title }} — {{ site.seo.title }}" />
<meta name="twitter:description" content="{{ site.shop.description }}" />
<meta name="twitter:image" content="{{ site.shop.og_image if site.shop.og_image else site.seo.og_image }}" />
{%- else %}
<meta name="twitter:title" content="{{ site.seo.title }}" />
<meta name="twitter:description" content="{{ site.seo.description }}" />
<meta name="twitter:image" content="{{ site.seo.og_image }}" />
{%- endif %}

{# ── Schema.org JSON-LD ───────────────────────────────────────────────────── #}
<script type="application/ld+json">
{
  "@context": "https://schema.org/",
  "@graph": [
    {
      "@type": "ProfilePage",
      "@id": "{{ site.seo.canonical }}#profile-page",
      "name": "{{ site.seo.title }}",
      "url": "{{ site.seo.canonical }}",
      "description": "{{ site.seo.description }}",
      "image": "{{ site.seo.og_image }}",
      "thumbnailUrl": "{{ site.seo.og_image }}",
      "significantLink": "{{ site.seo.canonical }}"
      {%- if site.seo.keywords %},
      "keywords": "{{ site.seo.keywords | join(', ') }}"
      {%- endif %}
      {%- if site.seo.date_created %},
      "dateCreated": "{{ site.seo.date_created }}"
      {%- endif %},
      "dateModified": "{{ buildMeta.iso }}",
      "mainEntity": { "@id": "{{ site.seo.canonical }}#person" }
      {%- if recentContent and recentContent.length %},
      "hasPart": [
        {%- for article in recentContent %}
        {%- if not loop.first %},{%- endif %}
        {
          "@type": "Article",
          "headline": "{{ article.headline | jsonEscape }}",
          "url": "{{ article.url }}",
          "image": "{{ article.image if article.image else site.seo.og_image }}"
          {%- if article.datePublished %},
          "datePublished": "{{ article.datePublished }}"
          {%- endif %},
          "author": { "@id": "{{ site.seo.canonical }}#person" }
        }
        {%- endfor %}
      ]
      {%- endif %}
    },
    {
      "@type": "Person",
      "@id": "{{ site.seo.canonical }}#person",
      "name": "{{ site.profile.name }}",
      "alternateName": "{{ site.profile.username }}",
      "identifier": "{{ site.profile.username }}",
      "description": "{{ site.profile.tagline if site.profile.tagline else site.seo.description }}",
      "image": "{{ site.seo.og_image }}",
      "url": "{{ site.seo.canonical }}"
      {%- if site.socials %},
      "sameAs": [
        {%- for social in site.socials %}
        "{{ social.url.split('?') | first }}"{% if not loop.last %},{% endif %}
        {%- endfor %}
      ]
      {%- endif %}
      {%- if site.seo.person and site.seo.person.roles %},
      "jobTitle": [
        {%- for role in site.seo.person.roles %}
        "{{ role.job_title | jsonEscape }}"{% if not loop.last %},{% endif %}
        {%- endfor %}
      ],
      "worksFor": [
        {%- for role in site.seo.person.roles %}
        {"@type": "Organization", "name": "{{ role.works_for | jsonEscape }}"{% if role.works_for_url %}, "url": "{{ role.works_for_url }}"{% endif %}}{% if not loop.last %},{% endif %}
        {%- endfor %}
      ]
      {%- endif %}
      {%- if socialStats and socialStats.stats and socialStats.stats.length %},
      "interactionStatistic": [
        {%- for stat in socialStats.stats %}
        {%- if not loop.first %},{%- endif %}
        {"@type": "InteractionCounter", "interactionType": "https://schema.org/FollowAction", "interactionService": {"@type": "Website", "name": "{{ stat.serviceName | jsonEscape }}", "url": "{{ stat.serviceUrl }}"}, "userInteractionCount": {{ stat.followersCount }}}
        {%- endfor %}
      ]
      {%- elif site.seo.person and site.seo.person.stats %},
      "interactionStatistic": [
        {%- set stats = site.seo.person.stats %}
        {%- if stats.followers %}
        {"@type": "InteractionCounter", "interactionType": "https://schema.org/FollowAction", "userInteractionCount": {{ stats.followers }}}{% if stats.posts_written %},{% endif %}
        {%- endif %}
        {%- if stats.posts_written %}
        {"@type": "InteractionCounter", "interactionType": "https://schema.org/WriteAction", "userInteractionCount": {{ stats.posts_written }}}
        {%- endif %}
      ]
      {%- endif %}
      {%- if site.profile.topics %},
      "knowsAbout": [
        {%- for topic in site.profile.topics %}
        "{{ topic | jsonEscape | safe }}"{% if not loop.last %},{% endif %}
        {%- endfor %}
      ]
      {%- endif %}
      {%- if site.profile.location %},
      "homeLocation": {"@type": "Place", "name": "{{ site.profile.location | jsonEscape | safe }}"}
      {%- endif %}
      {%- if site.profile.language %},
      "knowsLanguage": "{{ site.profile.language | jsonEscape | safe }}"
      {%- endif %}
      {%- if site.profile.creator_type %},
      "hasOccupation": {"@type": "Occupation", "name": "{{ site.profile.creator_type | jsonEscape | safe }}"}
      {%- endif %}
      {%- if site.seo.person and site.seo.person.awards %},
      "award": [
        {%- for award in site.seo.person.awards %}
        "{{ award | jsonEscape | safe }}"{% if not loop.last %},{% endif %}
        {%- endfor %}
      ]
      {%- endif %}
      {%- if site.seo.person and site.seo.person.credentials %},
      "hasCredential": [
        {%- for cred in site.seo.person.credentials %}
        {%- if not loop.first %},{%- endif %}
        {"@type": "EducationalOccupationalCredential", "name": "{{ cred.name | jsonEscape | safe }}"{% if cred.url %}, "url": "{{ cred.url }}"{% endif %}{% if cred.category %}, "credentialCategory": "{{ cred.category | jsonEscape | safe }}"{% endif %}}
        {%- endfor %}
      ]
      {%- endif %}
      {%- if site.profile.contact_url %},
      "contactPoint": {"@type": "ContactPoint", "contactType": "Work inquiries", "url": "{{ site.profile.contact_url }}"}
      {%- endif %}
    }
    {%- if site.sections %},
    {
      "@type": "ItemList",
      "@id": "{{ site.seo.canonical }}#links",
      "name": "{{ site.seo.title | jsonEscape }} — Links",
      "url": "{{ site.seo.canonical }}",
      "itemListElement": [
        {%- set allLinks = site.sections | flatLinks %}
        {%- for link in allLinks %}
        {%- if not loop.first %},{%- endif %}
        {"@type": "ListItem", "position": {{ link.position }}, "name": "{{ link.title | jsonEscape }}", "url": "{{ link.url }}"}
        {%- endfor %}
      ]
    }
    {%- endif %}
  ]
}
</script>

{# ── Shop page JSON-LD (ItemList with Course/Service/Product per item type) ── #}
{%- if shopPage and site.shop.enabled and site.shop.collections %}
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "ItemList",
  "name": "{{ site.shop.title | jsonEscape }} — {{ site.seo.title | jsonEscape }}",
  "url": "{{ site.seo.canonical }}/{{ site.shop.path }}/",
  "itemListElement": [
    {%- set _shopItems = site.shop.collections | shopItems %}
    {%- for item in _shopItems %}
    {%- if not loop.first %},{%- endif %}
    {
      "@type": "ListItem",
      "position": {{ item.position }},
      "item": {
        {%- if item.type == "course" %}
        "@type": "Course",
        "name": "{{ item.title | jsonEscape }}"
        {%- if item.description %},
        "description": "{{ item.description | jsonEscape }}"
        {%- endif %}
        {%- if item.image %},
        "image": "{{ item.image }}"
        {%- endif %},
        "url": "{{ item.url }}",
        "provider": {"@id": "{{ site.seo.canonical }}#person"}
        {%- if item.price is number %},
        "hasCourseInstance": {
          "@type": "CourseInstance",
          "courseMode": "online",
          "offers": {
            "@type": "Offer",
            "price": "{{ item.price }}",
            "priceCurrency": "{{ item.currency if item.currency else site.shop.currency }}",
            "availability": "https://schema.org/InStock",
            "url": "{{ item.url }}"
          }
        }
        {%- endif %}
        {%- elif item.type == "service" or item.type == "consultation" %}
        "@type": "Service",
        "name": "{{ item.title | jsonEscape }}"
        {%- if item.description %},
        "description": "{{ item.description | jsonEscape }}"
        {%- endif %}
        {%- if item.image %},
        "image": "{{ item.image }}"
        {%- endif %},
        "url": "{{ item.url }}"
        {%- if item.price is number %},
        "offers": {
          "@type": "Offer",
          "price": "{{ item.price }}",
          "priceCurrency": "{{ item.currency if item.currency else site.shop.currency }}",
          "availability": "https://schema.org/InStock",
          "url": "{{ item.url }}"
        }
        {%- endif %}
        {%- else %}
        "@type": "Product",
        "name": "{{ item.title | jsonEscape }}"
        {%- if item.description %},
        "description": "{{ item.description | jsonEscape }}"
        {%- endif %}
        {%- if item.image %},
        "image": "{{ item.image }}"
        {%- endif %},
        "url": "{{ item.url }}"
        {%- if item.price is number %},
        "offers": {
          "@type": "Offer",
          "price": "{{ item.price }}",
          "priceCurrency": "{{ item.currency if item.currency else site.shop.currency }}",
          "availability": "https://schema.org/InStock",
          "url": "{{ item.url }}"
        }
        {%- endif %}
        {%- endif %}
      }
    }
    {%- endfor %}
  ]
}
</script>
{%- endif %}

{# ── Theme CSS ────────────────────────────────────────────────────────────── #}
<link rel="stylesheet" href="/assets/base.css" />
{%- if site.shop and site.shop.enabled %}
<link rel="stylesheet" href="/assets/shop.css" />
{%- endif %}
<link rel="stylesheet" href="/themes/{{ site.theme }}/theme.css" />

{# ── Google Analytics (injected via GOOGLE_ANALYTICS_ID CI secret) ─────────── #}
{% if env.GOOGLE_ANALYTICS_ID %}
<script async src="https://www.googletagmanager.com/gtag/js?id={{ env.GOOGLE_ANALYTICS_ID }}"></script>
<script>
  window.dataLayer = window.dataLayer || [];
  function gtag(){dataLayer.push(arguments);}
  gtag('js', new Date());
  gtag('config', '{{ env.GOOGLE_ANALYTICS_ID }}');
</script>
<script>
(function () {
  var n = "{{ site.ga_event_name or 'creator_link_click' }}";
  document.addEventListener("click", function (e) {
    var a = e.target.closest("a");
    if (!a || typeof gtag === "undefined") return;
    var label   = a.dataset.gaLabel;
    var type    = a.dataset.gaType;
    var section = a.dataset.gaSection;
    if (!label) {
      var container = a.closest("[data-ga-section]");
      if (!container) return;
      section = section || container.dataset.gaSection;
      type    = type    || container.dataset.gaType || "auto_link";
      label   = (a.textContent || "").trim().toLowerCase().replace(/\s+/g, "_")
                || new URL(a.href, location.href).hostname.replace(/^www\./, "");
    }
    gtag("event", n, { destination: label, link_type: type, section: section });
  });
}());
</script>
{% endif %}

{# ── Favicons ─────────────────────────────────────────────────────────────── #}
<link rel="icon" type="image/png" href="/assets/favicon.png" />
<link rel="apple-touch-icon" href="/assets/apple-touch-icon.png" />
<meta name="theme-color" content="#1E2330" />
