{%- set _bk = site.integrations.booking %}
{%- if _bk and _bk.enabled and _bk.url %}
<section class="hb-widget hb-widget-booking" data-ga-widget="booking"
  aria-label="{{ _bk.heading or 'Book a Session' }}">
  {%- if _bk.heading %}<h2 class="hb-widget-heading">{{ _bk.heading }}</h2>{%- endif %}
  {%- if _bk.subheading %}<p class="hb-widget-subheading">{{ _bk.subheading }}</p>{%- endif %}

  {%- if _bk.embed %}
  {# ── Inline iframe embed ─────────────────────────────────────────────── #}
  {%- set _embedHeight = _bk.embed_height or 600 %}
  <iframe
    src="{{ _bk.url }}"
    class="hb-booking-embed"
    style="height:{{ _embedHeight }}px"
    frameborder="0"
    scrolling="auto"
    allowtransparency="true"
    title="{{ _bk.heading or 'Booking' }}">
  </iframe>
  {%- else %}
  {# ── Button link ─────────────────────────────────────────────────────── #}
  <div style="text-align:center">
    <a href="{{ _bk.url }}" target="_blank" rel="noopener"
      class="hb-btn"
      data-ga-label="booking-cta">
      <svg viewBox="0 0 24 24" width="18" height="18" fill="currentColor" aria-hidden="true"><path d="M19 3h-1V1h-2v2H8V1H6v2H5c-1.11 0-2 .9-2 2v14c0 1.1.89 2 2 2h14c1.1 0 2-.9 2-2V5c0-1.1-.9-2-2-2zm0 16H5V8h14v11zM7 10h5v5H7z"/></svg>
      {{ _bk.cta_label or 'Book a Call' }}
    </a>
  </div>
  {%- endif %}
</section>
{%- endif %}
