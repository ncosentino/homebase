{%- set _sb = site.integrations.support_buttons %}
{%- if _sb and _sb.enabled and _sb.buttons and _sb.buttons.length %}
<section class="hb-widget hb-widget-support-buttons" data-ga-widget="support_buttons"
  aria-label="{{ _sb.heading or 'Support' }}">
  {%- if _sb.heading %}<h2 class="hb-widget-heading">{{ _sb.heading }}</h2>{%- endif %}
  {%- if _sb.subheading %}<p class="hb-widget-subheading">{{ _sb.subheading }}</p>{%- endif %}
  <div class="hb-support-grid">
    {%- for btn in _sb.buttons %}
    <a href="{{ btn.url }}" target="_blank" rel="noopener"
      class="hb-btn-support"
      data-platform="{{ btn.platform }}"
      data-ga-label="support-{{ btn.platform }}">
