{%- set _nl = site.integrations.newsletter %}
{%- if _nl and _nl.enabled %}
{%- set _backend = _nl.backend or 'formspree' %}

{%- if _backend == 'mailchimp_embed' %}
{# ── Mailchimp hosted embed ──────────────────────────────────────────────── #}
<section class="hb-widget hb-widget-newsletter" data-ga-widget="newsletter"
  aria-label="{{ _nl.heading or 'Newsletter Signup' }}">
  {%- if _nl.heading %}<h2 class="hb-widget-heading">{{ _nl.heading }}</h2>{%- endif %}
  {%- if _nl.subheading %}<p class="hb-widget-subheading">{{ _nl.subheading }}</p>{%- endif %}
  <form action="{{ _nl.mailchimp_embed_url }}" method="post" target="_blank" novalidate>
    <div class="hb-form">
      <input type="email" name="EMAIL" class="hb-input"
        placeholder="{{ _nl.placeholder or 'your@email.com' }}" required />
      <div style="position:absolute;left:-5000px" aria-hidden="true">
        <input type="text" name="{{ _nl.mailchimp_honey_field or 'b_' }}" tabindex="-1" />
      </div>
      <button type="submit" class="hb-btn hb-btn-full">{{ _nl.cta_label or 'Subscribe' }}</button>
    </div>
    {%- if _nl.gdpr_note %}<p class="hb-privacy-note">{{ _nl.gdpr_note }}</p>{%- endif %}
  </form>
</section>

{%- elif _backend == 'beehiiv_embed' %}
{# ── Beehiiv hosted embed ────────────────────────────────────────────────── #}
<section class="hb-widget hb-widget-newsletter" data-ga-widget="newsletter"
  aria-label="{{ _nl.heading or 'Newsletter Signup' }}">
  {%- if _nl.heading %}<h2 class="hb-widget-heading">{{ _nl.heading }}</h2>{%- endif %}
  {%- if _nl.subheading %}<p class="hb-widget-subheading">{{ _nl.subheading }}</p>{%- endif %}
  <iframe
    src="https://embeds.beehiiv.com/subscribe?publication_id={{ _nl.beehiiv_publication_id }}&slim=true"
    data-test-id="beehiiv-embed"
    width="100%" height="52" frameborder="0" scrolling="no"
    style="border-radius:8px;background:transparent;display:block;"></iframe>
  {%- if _nl.gdpr_note %}<p class="hb-privacy-note">{{ _nl.gdpr_note }}</p>{%- endif %}
</section>

{%- elif _backend == 'substack' %}
{# ── Substack link ───────────────────────────────────────────────────────── #}
<section class="hb-widget hb-widget-newsletter" data-ga-widget="newsletter"
  aria-label="{{ _nl.heading or 'Newsletter Signup' }}">
  {%- if _nl.heading %}<h2 class="hb-widget-heading">{{ _nl.heading }}</h2>{%- endif %}
  {%- if _nl.subheading %}<p class="hb-widget-subheading">{{ _nl.subheading }}</p>{%- endif %}
  <div style="text-align:center">
    <a href="{{ _nl.substack_url }}/subscribe" target="_blank" rel="noopener"
      class="hb-btn"
      data-ga-label="newsletter-substack">{{ _nl.cta_label or 'Subscribe on Substack' }}</a>
  </div>
  {%- if _nl.gdpr_note %}<p class="hb-privacy-note">{{ _nl.gdpr_note }}</p>{%- endif %}
</section>

{%- else %}
{# ── Formspree / ConvertKit / Web3Forms (AJAX) ───────────────────────────── #}
<section class="hb-widget hb-widget-newsletter"
  data-ga-widget="newsletter"
  data-backend="{{ _backend }}"
  data-formspree-id="{{ _nl.formspree_id }}"
  data-convertkit-form-id="{{ _nl.convertkit_form_id }}"
  data-web3forms-key="{{ _nl.web3forms_key }}"
  data-success-msg="{{ _nl.success_message or "You're subscribed! Check your inbox." }}"
  aria-label="{{ _nl.heading or 'Newsletter Signup' }}">
  {%- if _nl.heading %}<h2 class="hb-widget-heading">{{ _nl.heading }}</h2>{%- endif %}
  {%- if _nl.subheading %}<p class="hb-widget-subheading">{{ _nl.subheading }}</p>{%- endif %}
  <form class="hb-form" novalidate>
    <div class="hb-form-row">
      <input type="email" class="hb-input"
        placeholder="{{ _nl.placeholder or 'your@email.com' }}"
        autocomplete="email" required />
      <button type="submit" class="hb-btn">{{ _nl.cta_label or 'Subscribe' }}</button>
    </div>
    {%- if _nl.gdpr_note %}<p class="hb-privacy-note">{{ _nl.gdpr_note }}</p>{%- endif %}
  </form>
  <p class="hb-msg" aria-live="polite"></p>
</section>
{%- endif %}
{%- endif %}
