{%- set _sf = site.integrations.social_follow %}
{%- if _sf and _sf.enabled and _sf.buttons and _sf.buttons.length %}
<section class="hb-widget hb-widget-social-follow" data-ga-widget="social_follow"
  aria-label="{{ _sf.heading or 'Follow on Social' }}">
