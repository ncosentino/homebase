<div class="profile">
  {# ── UTM helpers for profile links ── #}
  {%- set _utm = site.utm if site.utm else {} -%}
  {%- set _utmSource   = _utm.source -%}
  {%- set _utmMedium   = _utm.medium -%}
  {%- set _utmCampaign = _utm.campaign -%}
  {%- set _utmContent  = _utm.content -%}
  {%- set _utmTerm     = _utm.term -%}

  {%- macro utmHref(url) -%}
    {%- if _utmSource and url -%}
      {%- set _sep = "?" if "?" not in url else "&" -%}
      {{- url + _sep + "utm_source=" + _utmSource
        + ("&utm_medium="   + _utmMedium   if _utmMedium)
        + ("&utm_campaign=" + _utmCampaign if _utmCampaign)
        + ("&utm_content="  + _utmContent  if _utmContent)
        + ("&utm_term="     + _utmTerm     if _utmTerm) -}}
    {%- else -%}
      {{- url -}}
    {%- endif -%}
  {%- endmacro -%}

  {%- set _qrCfg = site.integrations.qr_code if site.integrations else null %}
  {%- set _qrDisplay = (_qrCfg.display or "widget") if (_qrCfg and _qrCfg.enabled and qrCode and qrCode.svg) else "widget" %}
  {%- set _qrHasBanner = true if site.profile.banner else false %}
  {%- set _bannerFade     = true if site.profile.banner_fade     else false %}
  {%- set _bannerParallax = true if site.profile.banner_parallax else false %}
  {%- set _parallaxFactor = site.profile.parallax_factor | string if site.profile.parallax_factor else "0.3" %}

  {% if site.profile.banner %}

  {# ── Flip mode ── #}
  {%- if _qrDisplay == "flip" %}
  <div class="qr-flip-outer{% if _bannerFade %} banner-fade{% endif %}{% if _bannerParallax %} banner-parallax{% endif %}"{% if _bannerParallax %} data-parallax-factor="{{ _parallaxFactor }}"{% endif %} role="button" tabindex="0" aria-label="Tap to reveal QR code">
    <div class="qr-flip-inner">
      <div class="qr-flip-front">
        <img class="profile-banner" src="{{ site.profile.banner }}" alt="{{ site.profile.name }} banner" loading="eager" />
        <span class="qr-flip-hint">📱 Scan</span>
      </div>
      <div class="qr-flip-back">
        <div class="hb-qr-svg">{{ qrCode.svg | safe }}</div>
        <p class="hb-qr-url">{{ qrCode.baseUrl | replace("https://", "") | replace("http://", "") }}</p>
        <p class="qr-flip-close-hint">Tap to flip back</p>
      </div>
    </div>
    <div class="avatar-over-banner">
      {% if site.profile.avatar_url %}<a href="{{ utmHref(site.profile.avatar_url) }}" target="_blank" rel="noopener noreferrer" aria-label="{{ site.profile.name }} profile">{% endif %}
      <img class="avatar" src="{{ site.profile.avatar }}" alt="{{ site.profile.name }} profile picture" width="80" height="80" loading="eager" />
      {% if site.profile.avatar_url %}</a>{% endif %}
    </div>
  </div>

  {# ── Side-by-side mode ── #}
  {%- elif _qrDisplay == "sidebyside" %}
  <div class="qr-sidebyside-row">
    <div class="qr-sidebyside-banner{% if _bannerFade %} banner-fade{% endif %}">
      <div class="banner-img-wrap{% if _bannerParallax %} banner-parallax-clip{% endif %}"{% if _bannerParallax %} data-parallax-factor="{{ _parallaxFactor }}"{% endif %}>
        {% if site.profile.banner_url %}<a href="{{ utmHref(site.profile.banner_url) }}" target="_blank" rel="noopener noreferrer" aria-label="Visit {{ site.profile.name }} website">{% endif %}
        <img class="profile-banner" src="{{ site.profile.banner }}" alt="{{ site.profile.name }} banner" loading="eager" />
        {% if site.profile.banner_url %}</a>{% endif %}
      </div>
      <div class="avatar-over-banner">
        {% if site.profile.avatar_url %}<a href="{{ utmHref(site.profile.avatar_url) }}" target="_blank" rel="noopener noreferrer" aria-label="{{ site.profile.name }} profile">{% endif %}
        <img class="avatar" src="{{ site.profile.avatar }}" alt="{{ site.profile.name }} profile picture" width="80" height="80" loading="eager" />
        {% if site.profile.avatar_url %}</a>{% endif %}
      </div>
    </div>
    <div class="qr-sidebyside-qr">
      <section class="hb-widget hb-widget-qr-code" data-ga-widget="qr_code" aria-label="{{ _qrCfg.heading or 'QR Code' }}">
        {%- if _qrCfg.heading %}
        <h2 class="hb-widget-heading">{{ _qrCfg.heading }}</h2>
        {%- endif %}
        <div class="hb-qr-inner">
          <div class="hb-qr-svg">{{ qrCode.svg | safe }}</div>
          {%- if _qrCfg.label %}<p class="hb-qr-label">{{ _qrCfg.label }}</p>{%- endif %}
          <p class="hb-qr-url">{{ qrCode.baseUrl | replace("https://", "") | replace("http://", "") }}</p>
          {%- if _qrCfg.show_download != false %}
          <a class="hb-qr-download link-btn" href="{{ qrCode.dataUri }}" download="qr-code.svg" aria-label="Download QR code">
            <span class="link-btn-label">↓ Save QR Code</span>
          </a>
          {%- endif %}
        </div>
      </section>
    </div>
  </div>

  {# ── Badge mode (or default with badge) ── #}
  {%- elif _qrDisplay == "badge" %}
  {%- set _badgeCorner = _qrCfg.badge_corner or "bottom_right" %}
  <div class="profile-banner-wrap{% if _bannerFade %} banner-fade{% endif %}">
    <div class="banner-img-wrap{% if _bannerParallax %} banner-parallax-clip{% endif %}"{% if _bannerParallax %} data-parallax-factor="{{ _parallaxFactor }}"{% endif %}>
      {% if site.profile.banner_url %}<a href="{{ utmHref(site.profile.banner_url) }}" target="_blank" rel="noopener noreferrer" aria-label="Visit {{ site.profile.name }} website">{% endif %}
      <img class="profile-banner" src="{{ site.profile.banner }}" alt="{{ site.profile.name }} banner" loading="eager" />
      {% if site.profile.banner_url %}</a>{% endif %}
    </div>
    <div class="hb-qr-badge hb-qr-badge--{{ _badgeCorner | replace("_", "-") }}" aria-label="QR code">{{ qrCode.badgeSvg | safe }}</div>
    <div class="avatar-over-banner">
      {% if site.profile.avatar_url %}<a href="{{ utmHref(site.profile.avatar_url) }}" target="_blank" rel="noopener noreferrer" aria-label="{{ site.profile.name }} profile">{% endif %}
      <img class="avatar" src="{{ site.profile.avatar }}" alt="{{ site.profile.name }} profile picture" width="80" height="80" loading="eager" />
      {% if site.profile.avatar_url %}</a>{% endif %}
    </div>
  </div>

  {# ── Default banner (widget / sticky / compact — no hero modification needed) ── #}
  {%- else %}
  <div class="profile-banner-wrap{% if _bannerFade %} banner-fade{% endif %}">
    <div class="banner-img-wrap{% if _bannerParallax %} banner-parallax-clip{% endif %}"{% if _bannerParallax %} data-parallax-factor="{{ _parallaxFactor }}"{% endif %}>
      {% if site.profile.banner_url %}<a href="{{ utmHref(site.profile.banner_url) }}" target="_blank" rel="noopener noreferrer" aria-label="Visit {{ site.profile.name }} website">{% endif %}
      <img class="profile-banner" src="{{ site.profile.banner }}" alt="{{ site.profile.name }} banner" loading="eager" />
      {% if site.profile.banner_url %}</a>{% endif %}
    </div>
    <div class="avatar-over-banner">
      {% if site.profile.avatar_url %}<a href="{{ utmHref(site.profile.avatar_url) }}" target="_blank" rel="noopener noreferrer" aria-label="{{ site.profile.name }} profile">{% endif %}
      <img class="avatar" src="{{ site.profile.avatar }}" alt="{{ site.profile.name }} profile picture" width="80" height="80" loading="eager" />
      {% if site.profile.avatar_url %}</a>{% endif %}
    </div>
  </div>
  {%- endif %}

  {% else %}
  <div class="avatar-wrap">
    {% if site.profile.avatar_url %}<a href="{{ utmHref(site.profile.avatar_url) }}" target="_blank" rel="noopener noreferrer" aria-label="{{ site.profile.name }} profile">{% endif %}
    <img class="avatar" src="{{ site.profile.avatar }}" alt="{{ site.profile.name }} profile picture" width="96" height="96" loading="eager" />
    {% if site.profile.avatar_url %}</a>{% endif %}
  </div>
  {% endif %}
  <h1 class="profile-name">{{ site.profile.name }}</h1>
  {% if site.profile.username %}
  <p class="profile-username">{{ site.profile.username }}</p>
  {% endif %}
  <p class="profile-bio">{{ site.profile.bio }}</p>
  {%- if site.profile.tagline and site.profile.show_tagline != false %}
  <p class="profile-tagline">{{ site.profile.tagline }}</p>
  {%- endif %}
  {%- if site.profile.topics and site.profile.show_topics != false %}
  <ul class="topic-chips">
    {%- for topic in site.profile.topics %}
    <li class="topic-chip">{{ topic }}</li>
    {%- endfor %}
  </ul>
  {%- endif %}
  {%- if site.profile.show_badges != false and (site.profile.location or site.profile.language or site.profile.creator_type) %}
  <ul class="profile-badges">
    {%- if site.profile.location %}<li class="profile-badge">{{ site.profile.location }}</li>{%- endif %}
    {%- if site.profile.language %}<li class="profile-badge">{{ site.profile.language }}</li>{%- endif %}
    {%- if site.profile.creator_type %}<li class="profile-badge">{{ site.profile.creator_type }}</li>{%- endif %}
  </ul>
  {%- endif %}
  {%- if site.profile.contact_url and site.profile.show_contact_cta != false %}
  <a class="profile-contact-cta" href="{{ site.profile.contact_url }}" target="_blank" rel="noopener noreferrer">Work with me &rarr;</a>
  {%- endif %}
  {%- if site.profile.show_total_reach != false and socialStats and socialStats.totalReach %}
  <p class="profile-total-reach">Total Audience: {{ (socialStats.totalReach / 1000) | round(1) }}k+</p>
  {%- endif %}
  {%- if site.shop and site.shop.enabled %}
  {% include "shop-nav.njk" %}
  {%- endif %}
  {% if site.socials and site.socials.length %}
  <div class="social-icons-strip" role="list">
    {% for item in site.socials %}
    {%- if item.show_icon != false %}
    {%- set _badgeParts = [] %}
    {%- if site.profile.show_follower_badges != false %}
      {%- if item.followers %}
        {%- if _badgeParts.push(item.followers) %}{% endif %}
      {%- elif socialStats and socialStats.stats %}
        {%- for stat in socialStats.stats %}
          {%- if not _badgeParts.length and (item.icon | lower) in (stat.serviceName | lower) %}
            {%- if _badgeParts.push(stat.followersCount) %}{% endif %}
          {%- endif %}
        {%- endfor %}
      {%- endif %}
    {%- endif %}
    <span class="social-icon-wrap">
    <a class="social-icon-link" href="{{ utmHref(item.url) }}" target="_blank" rel="noopener noreferrer" aria-label="{{ item.icon }}" role="listitem"
       data-ga-label="{{ item.icon }}" data-ga-type="social_icon" data-ga-section="social_icons">
      {% icon item.icon %}
    </a>
    {%- if _badgeParts | length %}<span class="follower-badge">{{ (_badgeParts | first / 1000) | round(1) }}k</span>{%- endif %}
    </span>
    {%- endif %}
    {% endfor %}
  </div>
  {% endif %}
  {%- if site.profile.show_extended_bio == true and site.profile.extended_bio %}
  {%- set _bioLabel = site.profile.extended_bio_label if site.profile.extended_bio_label else ("About " + site.profile.name) %}
  <details class="bio-extended"{% if site.profile.extended_bio_expanded == true %} open{% endif %}>
    <summary class="bio-extended-toggle">{{ _bioLabel }}</summary>
    <div class="bio-extended-body" data-ga-section="extended_bio" data-ga-type="bio_link">{{ site.profile.extended_bio | addUTM(site.utm) | nl2br | safe }}</div>
  </details>
  {%- endif %}
</div>
