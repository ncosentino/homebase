<div class="profile">
  {# ── UTM helpers for profile links ── #}
  {%- set _utm = site.utm if site.utm else {} -%}
  {%- set _utmSource   = _utm.source -%}
  {%- set _utmMedium   = _utm.medium -%}
  {%- set _utmCampaign = _utm.campaign -%}
  {%- set _utmContent  = _utm.content -%}
  {%- set _utmTerm     = _utm.term -%}

  {%- macro utmHref(url) -%}
    {%- if _utmSource and url -%}
      {%- set _sep = "?" if "?" not in url else "&" -%}
      {{- url + _sep + "utm_source=" + _utmSource
        + ("&utm_medium="   + _utmMedium   if _utmMedium)
        + ("&utm_campaign=" + _utmCampaign if _utmCampaign)
        + ("&utm_content="  + _utmContent  if _utmContent)
        + ("&utm_term="     + _utmTerm     if _utmTerm) -}}
    {%- else -%}
      {{- url -}}
    {%- endif -%}
  {%- endmacro -%}

  {% if site.profile.banner %}
  <div class="profile-banner-wrap">
    {% if site.profile.banner_url %}<a href="{{ utmHref(site.profile.banner_url) }}" target="_blank" rel="noopener noreferrer" aria-label="Visit {{ site.profile.name }} website">{% endif %}
    <img class="profile-banner" src="{{ site.profile.banner }}" alt="{{ site.profile.name }} banner" loading="eager" />
    {% if site.profile.banner_url %}</a>{% endif %}
    <div class="avatar-over-banner">
      {% if site.profile.avatar_url %}<a href="{{ utmHref(site.profile.avatar_url) }}" target="_blank" rel="noopener noreferrer" aria-label="{{ site.profile.name }} profile">{% endif %}
      <img class="avatar" src="{{ site.profile.avatar }}" alt="{{ site.profile.name }} profile picture" width="80" height="80" loading="eager" />
      {% if site.profile.avatar_url %}</a>{% endif %}
    </div>
  </div>
  {% else %}
  <div class="avatar-wrap">
    {% if site.profile.avatar_url %}<a href="{{ utmHref(site.profile.avatar_url) }}" target="_blank" rel="noopener noreferrer" aria-label="{{ site.profile.name }} profile">{% endif %}
    <img class="avatar" src="{{ site.profile.avatar }}" alt="{{ site.profile.name }} profile picture" width="96" height="96" loading="eager" />
    {% if site.profile.avatar_url %}</a>{% endif %}
  </div>
  {% endif %}
  <h1 class="profile-name">{{ site.profile.name }}</h1>
  {% if site.profile.username %}
  <p class="profile-username">{{ site.profile.username }}</p>
  {% endif %}
  <p class="profile-bio">{{ site.profile.bio }}</p>
  {%- if site.profile.tagline and site.profile.show_tagline != false %}
  <p class="profile-tagline">{{ site.profile.tagline }}</p>
  {%- endif %}
  {%- if site.profile.topics and site.profile.show_topics != false %}
  <ul class="topic-chips">
    {%- for topic in site.profile.topics %}
    <li class="topic-chip">{{ topic }}</li>
    {%- endfor %}
  </ul>
  {%- endif %}
  {%- if site.profile.show_badges != false and (site.profile.location or site.profile.language or site.profile.creator_type) %}
  <ul class="profile-badges">
    {%- if site.profile.location %}<li class="profile-badge">{{ site.profile.location }}</li>{%- endif %}
    {%- if site.profile.language %}<li class="profile-badge">{{ site.profile.language }}</li>{%- endif %}
    {%- if site.profile.creator_type %}<li class="profile-badge">{{ site.profile.creator_type }}</li>{%- endif %}
  </ul>
  {%- endif %}
  {%- if site.profile.contact_url and site.profile.show_contact_cta != false %}
  <a class="profile-contact-cta" href="{{ site.profile.contact_url }}" target="_blank" rel="noopener noreferrer">Work with me &rarr;</a>
  {%- endif %}
  {%- if site.profile.show_total_reach != false and socialStats and socialStats.totalReach %}
  <p class="profile-total-reach">Total Audience: {{ (socialStats.totalReach / 1000) | round(1) }}k+</p>
  {%- endif %}
  {% if site.social_icons and site.social_icons.length %}
  <div class="social-icons-strip" role="list">
    {% for item in site.social_icons %}
    {%- set _badgeParts = [] %}
    {%- if site.profile.show_follower_badges != false %}
      {%- if item.followers %}
        {%- if _badgeParts.push(item.followers) %}{% endif %}
      {%- elif socialStats and socialStats.stats %}
        {%- for stat in socialStats.stats %}
          {%- if not _badgeParts.length and (item.icon | lower) in (stat.serviceName | lower) %}
            {%- if _badgeParts.push(stat.followersCount) %}{% endif %}
          {%- endif %}
        {%- endfor %}
      {%- endif %}
    {%- endif %}
    <span class="social-icon-wrap">
    <a class="social-icon-link" href="{{ item.url }}" target="_blank" rel="noopener noreferrer" aria-label="{{ item.icon }}" role="listitem">
      {% icon item.icon %}
    </a>
    {%- if _badgeParts | length %}<span class="follower-badge">{{ (_badgeParts | first / 1000) | round(1) }}k</span>{%- endif %}
    </span>
    {% endfor %}
  </div>
  {% endif %}
</div>
