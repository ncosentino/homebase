---
permalink: /index.html
---
<!DOCTYPE html>
<html lang="{{ site.seo.locale if site.seo.locale else 'en' }}">
<head>
  {% include "head.njk" %}
</head>
<body{% if site.profile.banner_hero %} class="banner-hero-active"{% endif %}>
  <main class="page-wrap">
    <div class="content-col">

      {# ── Profile ──────────────────────────────────────────────────────── #}
      {%- set page = "links" %}
      {% include "profile.njk" %}

      {# ── SLOT: after_profile ──────────────────────────────────────────── #}
      {%- set _slot = 'after_profile' %}
      {%- include "integrations/_slot.njk" %}

      {# ── Featured Videos ─────────────────────────────────────────────── #}
      {# Prefer live channel feed; fall back to manually configured videos #}
      {% set _videos = youtubeChannels if youtubeChannels.length else site.featured_videos %}
      {% if _videos and _videos.length %}
      {% for video in _videos %}
      {% include "featured-video.njk" %}
      {% endfor %}
      {% endif %}

      {# ── SLOT: after_videos ───────────────────────────────────────────── #}
      {%- set _slot = 'after_videos' %}
      {%- include "integrations/_slot.njk" %}

      {# ── Link Sections ───────────────────────────────────────────────── #}
      {% for section in site.sections %}
      <section class="link-section">
        {% include "link-section.njk" %}
      </section>
      {% endfor %}

      {# ── SLOT: after_links ────────────────────────────────────────────── #}
      {%- set _slot = 'after_links' %}
      {%- include "integrations/_slot.njk" %}

      {# ── SLOT: bottom ─────────────────────────────────────────────────── #}
      {%- set _slot = 'bottom' %}
      {%- include "integrations/_slot.njk" %}

    </div>
  </main>

  {# Lazy-load lite-youtube.js only when a video element is near the viewport   #}
  {# Avoids loading 61 KiB of JS on pages with no videos or where all videos    #}
  {# are below the fold. IntersectionObserver injects the script on demand.     #}
  {% if _videos and _videos.length %}
  <script>
  (function(){
    var el = document.querySelector('.lite-youtube');
    if (!el) return;
    var io = new IntersectionObserver(function(entries, obs){
      if (!entries[0].isIntersecting) return;
      obs.disconnect();
      var s = document.createElement('script');
      s.src = '/assets/lite-youtube.js';
      document.body.appendChild(s);
    }, { rootMargin: '200px' });
    io.observe(el);
  })();
  </script>
  {% endif %}
</body>
</html>
